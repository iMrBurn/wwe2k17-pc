<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>WWE2K17Launcher</AssemblyName>
    <RootNamespace>Launcher</RootNamespace>
    <!-- the version of the whole project, from the VERSION file: the launcher compares it with the newest release -->
    <Version Condition="Exists('..\VERSION')">$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\..\VERSION').Trim())</Version>
    <Version Condition="!Exists('..\VERSION')">0.0.0</Version>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <!-- Icon built from the game's own art: kept out of Git (launcher_art/ is ignored), used when present. -->
  <PropertyGroup Condition="Exists('..\launcher_art\launcher.ico')">
    <ApplicationIcon>..\launcher_art\launcher.ico</ApplicationIcon>
  </PropertyGroup>
</Project>
