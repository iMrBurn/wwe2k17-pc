<Window x:Class="Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WWE 2K17 PC" Width="1112" Height="672"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        FontFamily="Bahnschrift Light, Bahnschrift, Segoe UI" TextOptions.TextFormattingMode="Display"
        Focusable="True" PreviewKeyDown="Window_PreviewKeyDown">
  <Window.Resources>
    <Style x:Key="Caption" TargetType="Button">
      <Setter Property="Foreground" Value="#9A9AA6"/>
      <Setter Property="Width" Value="40"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                TextElement.Foreground="{TemplateBinding Foreground}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#33FFFFFF"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border Margin="16" BorderBrush="#40FFFFFF" BorderThickness="1" x:Name="Frame">
    <Border.Effect><DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.8"/></Border.Effect>
    <Border.Background>
      <RadialGradientBrush Center="0.72,0.35" GradientOrigin="0.72,0.3" RadiusX="0.85" RadiusY="0.95">
        <GradientStop Color="#5A5A5C" Offset="0"/>
        <GradientStop Color="#2E2E30" Offset="0.45"/>
        <GradientStop Color="#141415" Offset="1"/>
      </RadialGradientBrush>
    </Border.Background>

    <Grid ClipToBounds="True">
      <!-- Smoke -->
      <Canvas x:Name="Smoke" IsHitTestVisible="False"/>
      <!-- Stadium lights -->
      <Canvas x:Name="Lights" IsHitTestVisible="False"/>
      <!-- Optional artwork (launcher_art\hero.png), never shipped -->
      <Image x:Name="HeroImage" HorizontalAlignment="Right" VerticalAlignment="Bottom" Stretch="Uniform"
             Margin="0,50,24,0" IsHitTestVisible="False" Visibility="Collapsed">
        <Image.Effect><DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.55"/></Image.Effect>
      </Image>
      <!-- Vignette -->
      <Rectangle IsHitTestVisible="False">
        <Rectangle.Fill>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#99000000" Offset="0"/>
            <GradientStop Color="#00000000" Offset="0.55"/>
          </LinearGradientBrush>
        </Rectangle.Fill>
      </Rectangle>

      <Grid MouseLeftButtonDown="TitleBar_MouseDown" Background="Transparent" Height="34" VerticalAlignment="Top">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Style="{StaticResource Caption}" Content="—" Click="Min_Click"/>
          <Button Style="{StaticResource Caption}" Content="✕" Click="Close_Click"/>
        </StackPanel>
      </Grid>

      <!-- Left column -->
      <StackPanel Margin="78,44,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Width="460">
        <Grid x:Name="LogoBox" Height="120" Margin="0,0,0,26">
          <StackPanel x:Name="LogoText" Orientation="Horizontal" VerticalAlignment="Center">
            <Image x:Name="LogoImage" Visibility="Collapsed" Height="104" Stretch="Uniform" Margin="0,0,10,0">
              <Image.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="0" Opacity="0.6"/></Image.Effect>
            </Image>
            <TextBlock x:Name="WweText" Text="WWE" FontSize="30" FontWeight="Black" FontStyle="Italic" Foreground="#E8E8EC"
                       VerticalAlignment="Top" Margin="0,8,8,0"/>
            <TextBlock Text="2K" FontSize="84" FontWeight="Black" FontStyle="Italic" Foreground="#C4141F" Margin="0,-14,0,0">
              <TextBlock.Effect><DropShadowEffect Color="#E5162B" BlurRadius="18" ShadowDepth="0" Opacity="0.5"/></TextBlock.Effect>
            </TextBlock>
            <TextBlock Text="17" FontSize="84" FontWeight="Black" FontStyle="Italic" Foreground="#C9C9CF" Margin="0,-14,0,0"/>
          </StackPanel>
        </Grid>
        <TextBlock x:Name="ScreenTitle" Text="MENU PRINCIPAL" Foreground="#EDEDF0" FontSize="26" Margin="2,0,0,8"/>
        <StackPanel x:Name="ItemsPanel"/>
        <TextBlock x:Name="InfoText" Foreground="#A8A8B2" FontSize="13" TextWrapping="Wrap" Margin="2,12,0,0"/>
        <TextBlock x:Name="StatusText" Foreground="#F2B632" FontSize="12" TextWrapping="Wrap" Margin="2,10,0,0"/>
        <Border x:Name="ProgressTrack" Height="6" Width="456" HorizontalAlignment="Left" Margin="2,10,0,0"
                Background="#44FFFFFF" Visibility="Collapsed">
          <Rectangle x:Name="ProgressFill" HorizontalAlignment="Left" Width="0" Fill="#E5162B"/>
        </Border>
        <TextBlock x:Name="LogLine" Foreground="#85858F" FontSize="10" FontFamily="Consolas" TextTrimming="CharacterEllipsis" Margin="2,2,0,0"/>
      </StackPanel>

      <!-- Prompts, bottom-left -->
      <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="82,0,0,30">
        <Border Background="#C8C8CC" CornerRadius="9" Width="18" Height="18" Margin="0,0,7,0">
          <TextBlock Text="↵" Foreground="#222" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <TextBlock Text="SÉLECTIONNER" Foreground="#E0E0E6" FontSize="11" VerticalAlignment="Center" Margin="0,0,22,0"/>
        <Border Background="#C4141F" CornerRadius="9" Width="18" Height="18" Margin="0,0,7,0">
          <TextBlock Text="✕" Foreground="White" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <TextBlock Text="RETOUR" Foreground="#E0E0E6" FontSize="11" VerticalAlignment="Center"/>
      </StackPanel>

      <!-- Status, bottom-right -->
      <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,44,30,0">
        <StackPanel x:Name="Checks" HorizontalAlignment="Right" Margin="0,0,0,6"/>
        <TextBlock x:Name="VersionText" Foreground="#6E6E78" FontSize="10" HorizontalAlignment="Right"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
